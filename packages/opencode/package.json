{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@oy-cli/opencode",
  "version": "0.14.5",
  "description": "OpenCode agent and skills for repeatable audits, code reviews, and focused fixes",
  "keywords": [
    "opencode",
    "coding-agent",
    "code-review",
    "security-audit",
    "sarif",
    "developer-tools"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonm/oy-cli.git",
    "directory": "packages/opencode"
  },
  "exports": "./index.js",
  "files": [
    "index.js",
    "cursor-catalog.js",
    "cursor-bridge.js",
    "cursor-paths.js",
    "cursor-provider.js",
    "cursor-skills.js",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check cursor-catalog.js && node --check cursor-bridge.js && node --check cursor-paths.js && node --check cursor-provider.js && node --check cursor-skills.js",
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.27",
    "@stablekernel/opencode-cursor": "0.7.1"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "os": [
    "linux",
    "darwin"
  ]
}
