{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@oy-cli/opencode",
  "version": "0.14.11",
  "description": "OpenCode V2 agent, deterministic review skills, and high-fidelity Cursor integration",
  "keywords": [
    "opencode",
    "coding-agent",
    "code-review",
    "security-audit",
    "sarif",
    "developer-tools"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonm/oy-cli.git",
    "directory": "packages/opencode"
  },
  "exports": "./index.js",
  "files": [
    "index.js",
    "cursor-catalog.js",
    "cursor-bridge.js",
    "cursor-paths.js",
    "cursor-provider.js",
    "cursor-skills.js",
    "assets",
    "vendor",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check cursor-catalog.js && node --check cursor-bridge.js && node --check cursor-paths.js && node --check cursor-provider.js && node --check cursor-skills.js && node --check vendor/opencode-cursor/provider/index.js && node --check vendor/opencode-cursor/sidecar/agent-host.js",
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.14",
    "@cursor/sdk": "1.0.27"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "devDependencies": {
    "@ai-sdk/openai": "3.0.84",
    "@ai-sdk/openai-v4": "npm:@ai-sdk/openai@4.0.36"
  }
}
